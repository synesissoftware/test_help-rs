#! /usr/bin/env bash
set -euo pipefail

NIGHTLY_TOOLCHAIN="${NIGHTLY_TOOLCHAIN:-nightly-2026-09-10}"
CARGO="${HOME}/.cargo/bin/cargo"
if [[ ! -x "${CARGO}" ]]; then
	CARGO="$(command -v cargo || true)"
fi
if [[ -z "${CARGO}" ]]; then
	echo "error: cargo not found (install via https://rustup.rs/)" >&2
	exit 1
fi

RUSTC="$(rustup which --toolchain "${NIGHTLY_TOOLCHAIN}" rustc 2>/dev/null || true)"
if [[ -z "${RUSTC}" ]]; then
	echo "error: nightly toolchain is required for nightly-constants tests" >&2
	echo "  rustup toolchain install ${NIGHTLY_TOOLCHAIN}" >&2
	exit 1
fi

export RUSTC
export PATH="${HOME}/.cargo/bin:${PATH}"

exec "${CARGO}" "+${NIGHTLY_TOOLCHAIN}" test --features nightly-constants --locked "$@"
